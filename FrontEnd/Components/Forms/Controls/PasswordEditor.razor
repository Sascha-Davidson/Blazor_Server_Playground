@inherits FieldEditorBase<string>

<div>
    <InputText class="password-editor"
               required="@IsRequired"
               id="@Id"
               name="@Name"
               placeholder="@PlaceHolder"
               readonly="@ReadOnly"
               disabled="@Disabled"
               maxlength="@MaxLengthAttribute?.Length"
               data-Type="string"
               data-Editor-key="@(Global.IsDebug ? EditorKey : null)"
               Value="@Value"
               ValueChanged="@ValueChanged"
               ValueExpression="@(Expression ?? (() => Value))"
               @attributes="Attributes" />

    @if (Expression != null)
    {
        <ValidationMessage For="Expression" />
    }
</div>