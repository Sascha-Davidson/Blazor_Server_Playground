@typeparam TValue
@inherits FieldEditorBase<TValue>

<div>
    <InputCurrency class="currency-editor"
                   required="@IsRequired"
                   id="@Id"
                   name="@Name"
                   placeholder="@EffectivePlaceholder"
                   readonly="@ReadOnly"
                   disabled="@Disabled"
                   data-Type="decimal"
                   data-Editor-key="@(Global.IsDebug ? EditorKey : null)"
                   ShowCurrencySymbol="ShowInputCurrencySymbol"
                   Value="@Value"
                   ValueChanged="@ValueChanged"
                   ValueExpression="@(Expression ?? (() => Value))"
                   @attributes="Attributes"/>

    @if (Expression != null)
    {
        <ValidationMessage For="Expression" />
    }
</div>