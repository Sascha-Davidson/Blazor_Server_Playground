@inherits FieldEditorBase<int>

<div>
    <InputRange class="range-editor"
                required="@IsRequired"
                id="@Id"
                name="@Name"
                placeholder="@PlaceHolder"
                readonly="@ReadOnly"
                disabled="@Disabled"
                data-Type="int"
                data-Editor-key="@(Global.IsDebug ? EditorKey : null)"
                Value="@Value"
                ValueChanged="@ValueChanged"
                ValueExpression="@(Expression ?? (() => Value))"
                @attributes="Attributes"
                Min="@MinValue"
                Max="@MaxValue" />

    @if (Expression != null)
    {
        <ValidationMessage For="Expression" />
    }
</div>