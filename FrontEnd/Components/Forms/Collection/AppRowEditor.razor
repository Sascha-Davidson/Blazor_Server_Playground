@typeparam TValue
@inherits FieldRowBase<TValue>

<AppField Class="@FieldClass"
          LayoutClass="@ComputedFieldClass()">

    <AppFieldLabel Attributes="Attributes"
                   For="@SetId"
                   Description="@(Description ?? ExpressionDescription)">
        @(LabelText ?? ExpressionName)
    </AppFieldLabel>

    <AppFieldContent>
        <AppEditor TValue="TValue"
                   Value="@Value"
                   ValueChanged="@ValueChanged"
                   Expression="@Expression"
                   Required="@Required"
                   ForceBlazor="@ForceBlazor"
                   CheckboxStyle="@CheckboxStyle"
                   Id="@SetId"
                   Name="@Name"
                   PlaceHolder="@PlaceHolder"
                   ReadOnly="@ReadOnly"
                   Disabled="@Disabled"
                   SelectList="@SelectList"
                   ValueSelector="@ValueSelector"
                   OptionContent="@OptionContent"
                   AutoComplete="@AutoComplete"/>
    </AppFieldContent>

    @ChildContent
</AppField>