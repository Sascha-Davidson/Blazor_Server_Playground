@inherits EditorBase<string>

<div>
    <InputText class="text-editor"
               required="@Required"
               id="@ID"
               name="@Name"
               placeholder="@PlaceHolder"
               readonly="@ReadOnly"
               disabled="@Disabled"
               maxlength="@MaxLengthAttribute?.Length"
               data-Type="TextEditor"
               data-Applayed-Type="@EditorKey" @bind-Value="Value"
               @attributes="Attributes" />
</div>