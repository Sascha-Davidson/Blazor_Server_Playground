@inherits EditorBase<DateTime>

<div>
    <InputDate class="time-editor"
               required="@IsRequired"
               id="@ID"
               name="@Name"
               placeholder="@PlaceHolder"
               readonly="@ReadOnly"
               disabled="@Disabled"
               data-Type="datetime"
               data-Editor-key="@(Global.IsDebug ? EditorKey : null)"
               Value="@Value"
               ValueChanged="@ValueChanged"
               ValueExpression="@(Expression ?? (() => Value))"
               @attributes="Attributes" />
    
    @if (Expression != null)
    {
        <ValidationMessage For="Expression" />
    }
</div>