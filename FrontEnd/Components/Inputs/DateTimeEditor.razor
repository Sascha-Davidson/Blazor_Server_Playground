@inherits EditorBase<DateTime>

<div>
    <InputDate class="date-time-editor"
               required="@Required"
               id="@ID"
               name="@Name"
               placeholder="@PlaceHolder"
               readonly="@ReadOnly"
               disabled="@Disabled"
               data-Type="DateTimeEditor"
               data-Applayed-Type="@EditorKey"
               @bind-Value="Value"
               @attributes="Attributes" />
</div>