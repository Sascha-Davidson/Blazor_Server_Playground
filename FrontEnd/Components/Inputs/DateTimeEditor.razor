@inherits EditorBase<DateTime>

<div>
    <InputDate class="date-time-editor"
               required="@Required"
               id="@ID"
               name="@Name"
               placeholder="@PlaceHolder"
               readonly="@ReadOnly"
               disabled="@Disabled"
               data-Type="datetime"
               data-Editor-key="@(Global.IsDebug ? EditorKey : null)"
               @bind-Value="Value"
               @attributes="Attributes" />
</div>