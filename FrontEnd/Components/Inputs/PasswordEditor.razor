@inherits EditorBase<string>

<div>
    <InputText class="password-editor"
               required="@Required"
               id="@ID"
               name="@Name"
               placeholder="@PlaceHolder"
               readonly="@ReadOnly"
               disabled="@Disabled"
               maxlength="@MaxLengthAttribute?.Length"
               data-Type="PasswordEditor"
               data-Applayed-Type="@EditorKey"
               @bind-Value="Value"
               @attributes="Attributes" />
</div>