@typeparam TValue
@inherits EditorBase<TValue>

<div>
    <InputNumber TValue="TValue"
                 class="number-editor"
                 required="@IsRequired"
                 id="@ID"
                 name="@Name"
                 placeholder="@PlaceHolder"
                 readonly="@ReadOnly"
                 disabled="@Disabled"
                 data-Type="int"
                 data-Editor-key="@(Global.IsDebug ? EditorKey : null)"
                 @bind-Value="Value"
                 @attributes="Attributes" />
</div>