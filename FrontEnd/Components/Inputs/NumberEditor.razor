@inherits EditorBase<string>

<InputText class="text-editor"
           required="@Required"
           id="@ID"
           name="@Name"
           placeholder="@PlaceHolder"
           readonly="@ReadOnly"
           disabled="@Disabled"
           min="@RangeMin?.ToInvariantString()"
           max="@RangeMax?.ToInvariantString()"
           Value="@Value"
           ValueChanged="@(v => ValueChanged.InvokeAsync(v))"
           ValueExpression="@(() => Value)"
           @attributes="Attributes" />