@typeparam TValue
@inherits EditorBase<TValue>

<div>
    <InputNumber TValue="TValue"
                 Type="range"
                 class="text-editor"
                 required="@Required"
                 id="@ID"
                 name="@Name"
                 placeholder="@PlaceHolder"
                 readonly="@ReadOnly"
                 disabled="@Disabled"
                 min="@RangeAttribute?.Minimum"
                 max="@RangeAttribute?.Maximum"
                 data-Type="PercentageEditor"
                 data-Applayed-Type="@EditorKey"
                 @bind-Value="Value"
                 @attributes="Attributes" />
</div>