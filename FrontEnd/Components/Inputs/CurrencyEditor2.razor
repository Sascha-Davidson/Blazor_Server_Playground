@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@inherits InputBase<decimal?>

<div>
    <input type="text"
           inputmode="decimal"
           class="@CssClass"
           required="@Required"
           id="@ID"
           name="@Name"
           placeholder="@PlaceHolder"
           readonly="@ReadOnly"
           disabled="@Disabled"
           data-DataType="@EditorKey"
           value="@DisplayValue"
           @onfocus="HandleFocus"
           @onblur="HandleBlur"
           @oninput="HandleInput"
           @attributes="AdditionalAttributes" />
</div>

@code {
    private bool _isEditing;
    private static readonly CultureInfo DutchCulture = new("nl-NL");

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public int ID { get; set; } = Guid.NewGuid().GetHashCode();

    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public string? PlaceHolder { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? EditorKey { get; set; }

    private string DisplayValue =>
        _isEditing
            ? CurrentValueAsString ?? ""
            : Value?.ToString("C2", DutchCulture) ?? "";

    protected override bool TryParseValueFromString(string? value, out decimal? result, out string? validationErrorMessage)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            result = null;
            validationErrorMessage = null;
            return true;
        }

        if (decimal.TryParse(value, NumberStyles.Any, DutchCulture, out var parsedValue))
        {
            result = parsedValue;
            validationErrorMessage = null;
            return true;
        }

        result = default;
        validationErrorMessage = "Please enter a valid decimal number.";
        return false;
    }

    protected override string? FormatValueAsString(decimal? value)
    {
        return _isEditing
            ? value?.ToString("0.##", DutchCulture)
            : value?.ToString("C2", DutchCulture);
    }

    private void HandleFocus(FocusEventArgs args)
    {
        _isEditing = true;
        StateHasChanged();
    }

    private void HandleBlur(FocusEventArgs args)
    {
        _isEditing = false;
        CurrentValue = Value;
        EditContext?.NotifyFieldChanged(FieldIdentifier);
    }

    private async Task HandleInput(ChangeEventArgs args)
    {
        if (decimal.TryParse(
                args.Value?.ToString(),
                NumberStyles.Any,
                DutchCulture,
                out var result))
        {
            CurrentValue = result;
        }
    }
}