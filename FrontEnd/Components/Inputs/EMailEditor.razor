@inherits EditorBase<string>

<div>
    <div>
        <InputEmail class="mail-editor"
                    required="@Required"
                    id="@ID"
                    name="@Name"
                    placeholder="@PlaceHolder"
                    readonly="@ReadOnly"
                    disabled="@Disabled"
                    data-Type="EmailEditor"
                    data-Applayed-Type="@EditorKey"
                    @bind-Value="Value"
                    @attributes="Attributes" />
    </div>

    <a href="@MailTo(Value)">
        Mail
    </a>
</div>

@code {
    private static string MailTo(string value) => $"mailto:{value}";

}