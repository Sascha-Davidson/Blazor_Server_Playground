@inherits EditorBase<string>

<div>
    <InputEmail class="text-editor"
                required="@Required"
                id="@ID"
                name="@Name"
                placeholder="@PlaceHolder"
                readonly="@ReadOnly"
                disabled="@Disabled"
                data-DataType="@EditorKey"
                @bind-Value="Value"
                @attributes="Attributes" />

                <a href="mailto:@Value">
                    Mail
                </a>
</div>