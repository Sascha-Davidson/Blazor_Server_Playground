@inherits EditorBase<int>

<div>
    <InputRange class="range-editor"
                required="@Required"
                id="@ID"
                name="@Name"
                placeholder="@PlaceHolder"
                readonly="@ReadOnly"
                disabled="@Disabled"
                data-Type="RangeEditor"
                data-Applayed-Type="@EditorKey"
                @bind-Value="Value"
                @attributes="Attributes"
                Min="@MinValue"
                Max="@MaxValue" />
</div>