@inherits EditorBase<int>

<div>
    <InputRange class="range-editor"
                required="@IsRequired"
                id="@ID"
                name="@Name"
                placeholder="@PlaceHolder"
                readonly="@ReadOnly"
                disabled="@Disabled"
                data-Type="int"
                data-Editor-key="@(Global.IsDebug ? EditorKey : null)"
                @bind-Value="Value"
                @attributes="Attributes"
                Min="@MinValue"
                Max="@MaxValue" />
</div>