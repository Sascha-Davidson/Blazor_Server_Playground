@inherits EditorBase<int>

<div>
    <InputRange class="text-editor"
                required="@Required"
                id="@ID"
                name="@Name"
                placeholder="@PlaceHolder"
                readonly="@ReadOnly"
                disabled="@Disabled"
                data-DataType="@EditorKey"
                @bind-Value="Value"
                @attributes="Attributes"
                Min="@MinValue"
                Max="@MaxValue" />
</div>