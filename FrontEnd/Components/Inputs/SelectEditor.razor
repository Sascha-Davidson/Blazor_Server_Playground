@inherits EditorBase<string>

<div class="editor-wrapper">
    <InputSelect class="app-select select-editor"
                 required="@IsRequired"
                 id="@ID"
                 name="@Name"
                 placeholder="@PlaceHolder"
                 readonly="@ReadOnly"
                 disabled="@Disabled"
                 data-Type="int"
                 data-Editor-key="@(Global.IsDebug ? EditorKey : null)"
                 Value="@Value"
                 ValueChanged="@ValueChanged"
                 ValueExpression="@(Expression ?? (() => Value))"
                 @attributes="Attributes">
        @* <button><selectedcontent></selectedcontent></button> *@
        @foreach (var item in SelectList)
        {
            <option value="@ValueSelector(item)">@OptionContent(item)</option>
        }
    </InputSelect>
    
    @if (Expression != null)
    {
        <ValidationMessage For="Expression" />
    }
</div>