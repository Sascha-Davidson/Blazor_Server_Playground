@inherits EditorBase<string>

<div>
    <InputTextArea class="textarea-editor"
                   required="@Required"
                   id="@ID"
                   name="@Name"
                   placeholder="@PlaceHolder"
                   readonly="@ReadOnly"
                   disabled="@Disabled"
                   maxlength="@MaxLengthAttribute?.Length"
                   data-Type="string"
                   data-Editor-key="@(Global.IsDebug ? EditorKey : null)"
                   @bind-Value="Value"
                   @attributes="Attributes" />
</div>
