@inherits EditorBase<decimal?>

<div>
    <InputCurrency class="text-editor"
                   required="@Required"
                   id="@ID"
                   name="@Name"
                   placeholder="@EffectivePlaceholder"
                   readonly="@ReadOnly"
                   disabled="@Disabled"
                   data-DataType="@EditorKey"
                   ShowCurrencySymbol="ShowInputCurrencySymbol"
                   @bind-Value="Value"
                   @attributes="Attributes"/>
</div>