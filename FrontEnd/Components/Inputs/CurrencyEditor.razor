@typeparam TValue
@inherits EditorBase<TValue>

<div>
    <InputCurrency class="currency-editor"
                   required="@IsRequired"
                   id="@ID"
                   name="@Name"
                   placeholder="@EffectivePlaceholder"
                   readonly="@ReadOnly"
                   disabled="@Disabled"
                   data-Type="decimal"
                   data-Editor-key="@(Global.IsDebug ? EditorKey : null)"
                   ShowCurrencySymbol="ShowInputCurrencySymbol"
                   @bind-Value="Value"
                   @attributes="Attributes"/>
</div>