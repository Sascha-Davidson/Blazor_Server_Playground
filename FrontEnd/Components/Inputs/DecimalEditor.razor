@typeparam TValue
@inherits EditorBase<TValue>

<div>
    <InputDecimal TValue="TValue"
                  class="decimal-editor"
                  required="@IsRequired"
                  id="@ID"
                  name="@Name"
                  placeholder="@PlaceHolder"
                  readonly="@ReadOnly"
                  disabled="@Disabled"
                  data-Type="decimal"
                  data-Editor-key="@(Global.IsDebug ? EditorKey : null)"
                  Value="@Value"
                  ValueChanged="@ValueChanged"
                  ValueExpression="@(Expression ?? (() => Value))"
                  @attributes="Attributes" />

    @if (Expression != null)
    {
        <ValidationMessage For="Expression" />
    }
</div>