@typeparam TValue
@inherits EditorBase<TValue>

<div>
    <InputDecimal TValue="TValue"
                 class="decimal-editor"
                 required="@Required"
                 id="@ID"
                 name="@Name"
                 placeholder="@PlaceHolder"
                 readonly="@ReadOnly"
                 disabled="@Disabled"
                 data-Type="decimal"
                 data-Editor-key="@(Global.IsDebug ? EditorKey : null)"
                 @bind-Value="Value"
                 @attributes="Attributes" />
</div>