@inherits EditorBase<bool>

<div class="checkbox-editor">
    @if (Style == CheckboxStyle.Slider)
    {
        <div class="slider-label">
            <InputCheckbox id="@ID"
                           name="@Name"
                           disabled="@Disabled"
                           checked="@Value"
                           required="@IsRequired"
                           data-Type="bool"
                           data-Editor-key="@(Global.IsDebug ? EditorKey : null)"
                           Value="@Value"
                           ValueChanged="@ValueChanged"
                           ValueExpression="@(Expression ?? (() => Value))"
                           @attributes="Attributes" />
            <span class="slider-track">
                <span class="slider-thumb"></span>
            </span>
        </div>
    }
    else
    {
        <div class="box-label">
            <InputCheckbox id="@ID"
                           name="@Name"
                           disabled="@Disabled"
                           checked="@Value"
                           required="@IsRequired"
                           data-Type="bool"
                           data-Editor-key="@(Global.IsDebug ? EditorKey : null)"
                           @bind-Value="Value"
                           @attributes="Attributes" />
        </div>
    }
</div>
