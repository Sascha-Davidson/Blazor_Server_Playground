@inherits EditorBase<bool>

<div class="checkbox-editor">
    @if (Style == CheckboxStyle.Slider)
    {
        <label class="slider-label">
            <InputCheckbox id="@ID"
                           name="@Name"
                           disabled="@Disabled"
                           checked="@Value"
                           data-Type="bool"
                           data-Editor-key="@(Global.IsDebug ? EditorKey : null)"
                           @bind-Value="Value"
                           @attributes="Attributes" />
            <span class="slider-track">
                <span class="slider-thumb"></span>
            </span>
        </label>
    }
    else
    {
        <label class="box-label">
            <InputCheckbox id="@ID"
                           name="@Name"
                           disabled="@Disabled"
                           checked="@Value"
                           data-Type="bool"
                           data-Editor-key="@(Global.IsDebug ? EditorKey : null)"
                           @bind-Value="Value"
                           @attributes="Attributes" />
        </label>
    }
</div>
