@inherits EditorBase<string>

<div>
    <InputPhone class="text-editor"
                required="@Required"
                id="@ID"
                name="@Name"
                placeholder="@PlaceHolder"
                readonly="@ReadOnly"
                disabled="@Disabled"
                data-DataType="@EditorKey"
                @bind-Value="Value"
                @attributes="Attributes" />


    <a href="tel:@Value">
        Call
    </a>
</div>