@inherits EditorBase<string>

<div>
    <InputPhone class="phone-editor"
                required="@IsRequired"
                id="@ID"
                name="@Name"
                placeholder="@PlaceHolder"
                readonly="@ReadOnly"
                disabled="@Disabled"
                data-Type="string"
                data-Editor-key="@(Global.IsDebug ? EditorKey : null)"
                @bind-Value="Value"
                @attributes="Attributes" />


    <a href="tel:@Value">
        Call
    </a>
</div>