@page "/"
@inherits BaseComponent

<PageTitle>@Global.FullName</PageTitle>

<div class="page">
    <div class="contact-details">
        <h1>Home</h1>
    </div>

    <div class="button-container">
        <AppButton OnClick="ResetTest">
            reset test
        </AppButton>

        <AppButton OnClick="RunTest" TooltipText="test">
            test button
        </AppButton>

        <AppButton OnConfirmed="RunTest" TooltipText="test" Origin="AnchorOrigin.Right" Direction="AnchorDirection.Center">
            test confirm button
        </AppButton>
    </div>
    <p>@Message</p>

</div>

@code {
    private string Message = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ScopedJs();
        }
    }

    private async Task RunTest()
    {
        if (JsModule is not null)
        {
            Message = await JsModule.InvokeAsync<string>("test");
        }
    }

    private async Task ResetTest()
    {
        Message = null;
    }
}