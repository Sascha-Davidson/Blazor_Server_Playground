@page "/"
@inherits BaseComponent

<PageTitle>@Global.FullName</PageTitle>

<div class="contact-details">
    <h1>Home</h1>
    
    <AppEditor Expression="() => Test" @bind-Value="Test" Required />
    
    <TextEditor @bind-Value="Test" Required />
    
    <SelectEditor Expression="() => Option" @bind-Value="Option" SelectList="SelectList" ValueSelector="x => x" />

    <AppRow Expression="() => Test" @bind-Value="Test" PlaceHolder="Test" />

    <AppRow Expression="() => Test2" @bind-Value="Test2" Orientation="RowOrientation.Vertical" PlaceHolder="Test2" />

    <AppRow Expression="() => Option" @bind-Value="Option" Orientation="RowOrientation.Vertical" SelectList="SelectList" ValueSelector="x => x" />

    <AppRow Expression="() => Test3" @bind-Value="Test3" />

    <style>
        select{
                padding: .75rem 1.2rem;
                border-radius: var(--radius-s);
                border: 1px solid var(--color-gray-200);
                outline-color: var(--color-success);
                background-color: var(--color-gray-000);
                cursor: pointer;
        }
    </style>

    <InputSelect class="app-select text-editor"
                 @bind-Value="Option">
        @* <button><selectedcontent></selectedcontent></button> *@
        @foreach (var item in SelectList)
        {
            <option value="@item">@item</option>
        }
    </InputSelect>
</div>

@code {
    [Display(Name = "test")]
    public string? Test { get; set; }

    [Display(Name = "test"), Required]
    public string? Test2 { get; set; }

    [Display(Name = "test")]
    public int Test3 { get; set; }

    private string? Option { get; set; }
    private static IEnumerable<string> SelectList =>
    [
        "Option 1",
        "Option 2",
        "Option 3"
    ];
}