@page "/editor-test-room"
@inherits BaseComponent

<div class="contact-details">
    <AppRowEditor Expression="() => FullName" @bind-Value="FullName" />
    <AppRowEditor Expression="() => Name" @bind-Value="Name" />
    <AppRowEditor Expression="() => LastName" @bind-Value="LastName" />

    <AppRowEditor Expression="() => CheckBoxEditor" @bind-Value="CheckBoxEditor" Required />

    <AppRowEditor Expression="() => CurrencyEditor" @bind-Value="CurrencyEditor" />
    <AppRowEditor Expression="() => CurrencyEditorNullable" @bind-Value="CurrencyEditorNullable" />

    <AppRowEditor Expression="() => DecimalEditor" @bind-Value="DecimalEditor" Required />
    <AppRowEditor Expression="() => DecimalEditorNullable" @bind-Value="DecimalEditorNullable" Required />

    <AppRowEditor Expression="() => DateEditor" @bind-Value="DateEditor" Required />
    <AppRowEditor Expression="() => EmailEditor" @bind-Value="EmailEditor" Required />
    <AppRowEditor Expression="() => NumberEditor" @bind-Value="NumberEditor" Required />
    <AppRowEditor Orientation="RowOrientation.Auto2" Expression="() => PasswordEditor" @bind-Value="PasswordEditor" Required />
    <AppRowEditor Expression="() => PercentageEditor" @bind-Value="PercentageEditor" Required />
    <AppRowEditor Expression="() => PhoneEditor" @bind-Value="PhoneEditor" Required />
    <AppRowEditor Expression="() => RangeEditor" @bind-Value="RangeEditor" Required />
    <AppRowEditor Expression="() => SearchEditor" @bind-Value="SearchEditor" Required />
    <AppRowEditor Expression="() => SelectEditor" @bind-Value="SelectEditor" Required />
    <AppRowEditor Expression="() => TextAreaEditor" @bind-Value="TextAreaEditor" Required />
    <AppRowEditor Expression="() => TextEditor" @bind-Value="TextEditor" Required />
    <AppRowEditor Expression="() => TimeEditor" @bind-Value="TimeEditor" Required>
        <AppEditor Expression="() => TimeEditor" @bind-Value="TimeEditor" />
    </AppRowEditor>
    <AppRowEditor Orientation="RowOrientation.Auto2" Expression="() => TimeEditor" @bind-Value="TimeEditor" Required>
        <AppEditor Expression="() => TimeEditor" @bind-Value="TimeEditor" />
    </AppRowEditor>
</div>

@code {
    [Display(Name = "Name"), AutoComplete(AutoCompleteType.Name), Required]
    public string FullName { get; set; }

    [Display(Name = "Name"), AutoComplete(AutoCompleteType.GivenName), Required]
    public string Name { get; set; }

    [Display(Name = "Name"), AutoComplete(AutoCompleteType.FamilyName), Required]
    public string LastName { get; set; }

    [Display(Name = "CheckBoxEditor")]
    public bool CheckBoxEditor { get; set; }

    [Display(Name = "Decimal")]
    public decimal DecimalEditor { get; set; }

    [Display(Name = "Decimal")]
    public decimal? DecimalEditorNullable { get; set; }

    [Display(Name = "Currency"), DataType("Currency")]
    public decimal CurrencyEditor{ get; set; }

    [Display(Name = "Currency"), DataType("Currency")]
    public decimal? CurrencyEditorNullable { get; set; }

    [Display(Name = "DateEditor")]
    public DateTime DateEditor { get; set; } = DateTime.Now;

    [DataType("Email")]
    public string EmailEditor { get; set; }

    [DataType("NumberEditor")]
    public int NumberEditor { get; set; }

    [DataType("PasswordEditor")]
    public string PasswordEditor { get; set; }

    [DataType("PercentageEditor")]
    public int PercentageEditor { get; set; }

    [DataType("Phone"), AutoComplete(AutoCompleteType.Tel)]
    public string PhoneEditor { get; set; }

    [DataType("Range"), Range(0, 100)]
    public int RangeEditor { get; set; }

    [DataType("SearchEditor")]
    public string SearchEditor { get; set; }

    [DataType("SelectEditor")]
    public string SelectEditor { get; set; }

    [DataType("TextAreaEditor")]
    public string TextAreaEditor { get; set; }

    [DataType("TextEditor")]
    public string TextEditor { get; set; }

    [DataType("TimeEditor")]
    public DateTime TimeEditor { get; set; } = DateTime.Now;

    private string Option { get; set; }
    private static IEnumerable<string> SelectList =>
    [
        "Option 1",
        "Option 2",
        "Option 3"
    ];

    private List<string> items = ["Apple", "Banana", "Cherry", "Date", "Elderberry"];

}