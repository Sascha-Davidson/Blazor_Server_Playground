@page "/editor-test-room"
@inherits BaseComponent

<div class="contact-details">
    <AppRow Expression="() => CheckBoxEditor" @bind-Value="CheckBoxEditor" Required />

    <AppRow Expression="() => CurrencyEditorNullable" @bind-Value="CurrencyEditorNullable" />

    <AppRow Expression="() => DecimalEditor" @bind-Value="DecimalEditor" Required />

    <AppRow Expression="() => DateEditor" @bind-Value="DateEditor" Required />
    <AppRow Expression="() => EmailEditor" @bind-Value="EmailEditor" Required />
    <AppRow Expression="() => NumberEditor" @bind-Value="NumberEditor" Required />
    <AppRow Expression="() => PasswordEditor" @bind-Value="PasswordEditor" Required />
    <AppRow Expression="() => PercentageEditor" @bind-Value="PercentageEditor" Required />
    <AppRow Expression="() => PhoneEditor" @bind-Value="PhoneEditor" Required />
    <AppRow Expression="() => RangeEditor" @bind-Value="RangeEditor" Required />
    <AppRow Expression="() => SearchEditor" @bind-Value="SearchEditor" Required />
    <AppRow Expression="() => SelectEditor" @bind-Value="SelectEditor" Required />
    <AppRow Expression="() => TextAreaEditor" @bind-Value="TextAreaEditor" Required />
    <AppRow Expression="() => TextEditor" @bind-Value="TextEditor" Required />
    <AppRow Expression="() => TimeEditor" @bind-Value="TimeEditor" Required />
</div>

@code {
    [Display(Name = "CheckBoxEditor")]
    public bool CheckBoxEditor { get; set; }

    [Display(Name = "Decimal (NumberEditor)")]
    public decimal DecimalEditor { get; set; }

    [Display(Name = "Currency (CurrencyEditor)")]
    [DataType("Currency")]
    public decimal? CurrencyEditorNullable { get; set; }

    [Display(Name = "DateEditor")]
    public DateTime DateEditor { get; set; } = DateTime.Now;

    [DataType("EmailEditor")]
    public string EmailEditor { get; set; }

    [DataType("NumberEditor")]
    public int NumberEditor { get; set; }

    [DataType("PasswordEditor")]
    public string PasswordEditor { get; set; }

    [DataType("PercentageEditor")]
    public int PercentageEditor { get; set; }

    [DataType("PhoneEditor")]
    public string PhoneEditor { get; set; }

    [DataType("Range")]
    [Range(0, 100)]
    public int RangeEditor { get; set; }

    [DataType("SearchEditor")]
    public string SearchEditor { get; set; }

    [DataType("SelectEditor")]
    public string SelectEditor { get; set; }

    [DataType("TextAreaEditor")]
    public string TextAreaEditor { get; set; }

    [DataType("TextEditor")]
    public string TextEditor { get; set; }

    [DataType("TimeEditor")]
    public DateTime TimeEditor { get; set; } = DateTime.Now;

    private string? Option { get; set; }
    private static IEnumerable<string> SelectList =>
    [
        "Option 1",
        "Option 2",
        "Option 3"
    ];

    private List<string> items = ["Apple", "Banana", "Cherry", "Date", "Elderberry"];

}