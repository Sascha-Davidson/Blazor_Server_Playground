@page "/error/test"

<PageTitle>@Global.FullName</PageTitle>

<div class="contact-details">

    <h1>error component test</h1>

    <div class="btn-container">
        <button @onclick="TriggerCrash">Trigger component crashCrash</button>
        <button @onclick="TriggerPageCrash">Trigger page crashCrash</button>
    </div>

    <ErrorBoundary>
        <ErrorContent>
            <p class="blazor-error-boundary">An error has occurred in the ErrorBoundary. Please try again later.</p>
        </ErrorContent>
        <ChildContent>
            <CrashableComponent @ref="crashableComponent" />
        </ChildContent>
    </ErrorBoundary>
</div>

@code {
    private CrashableComponent crashableComponent;

    private void TriggerPageCrash()
    {
        throw new InvalidOperationException();
    }

    private void TriggerCrash()
    {
        crashableComponent?.TriggerCrash();
    }
}
