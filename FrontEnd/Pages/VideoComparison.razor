@page "/video-compare"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Video Compare</PageTitle>

@{
    RenderFragment<VideoMetadata> MetadataRows = meta =>
    @<text>
        @if (!string.IsNullOrWhiteSpace(meta.AnalysisError))
        {
            <tr class="table-danger">
                <td>Analysis error</td>
                <td>@meta.AnalysisError</td>
            </tr>
        }
        <tr>
            <td>Resolution</td>
            <td>@meta.Width × @meta.Height</td>
        </tr>
        <tr>
            <td>Frame rate</td>
            <td>@Display(meta.FrameRate)</td>
        </tr>
        <tr>
            <td>Duration</td>
            <td>@meta.Duration.ToString("F2") s</td>
        </tr>
        <tr>
            <td>Video codec</td>
            <td>@Display(meta.VideoCodec)</td>
        </tr>
        <tr>
            <td>Video bitrate</td>
            <td>@Display(meta.VideoBitrate)</td>
        </tr>
        <tr>
            <td>Bit depth</td>
            <td>@Display(meta.BitDepth)</td>
        </tr>
        <tr>
            <td>Color space</td>
            <td>@Display(meta.ColorSpace)</td>
        </tr>
        <tr>
            <td>HDR</td>
            <td>@Display(meta.Hdr)</td>
        </tr>
        <tr>
            <td>Chroma subsampling</td>
            <td>@Display(meta.ChromaSubsampling)</td>
        </tr>
        <tr>
            <td>Audio codec</td>
            <td>@Display(meta.AudioCodec)</td>
        </tr>
        <tr>
            <td>Audio bitrate</td>
            <td>@Display(meta.AudioBitrate)</td>
        </tr>
        <tr>
            <td>Audio sample rate</td>
            <td>@Display(meta.AudioSampleRate)</td>
        </tr>
        <tr>
            <td>Audio channels</td>
            <td>@Display(meta.AudioChannels)</td>
        </tr>
        <tr>
            <td>Container</td>
            <td>@Display(meta.Container)</td>
        </tr>
        <tr>
            <td>File size</td>
            <td>@((meta.FileSize / 1024d / 1024d).ToString("F2")) MB</td>
        </tr>
    </text>;
}

<div class="mb-3 row">

    <div class="col">
        <label class="form-label">Video A</label>
        <InputFile OnChange="LoadVideoA" accept="video/*" />
    </div>

    <div class="col">
        <label class="form-label">Video B</label>
        <InputFile OnChange="LoadVideoB" accept="video/*" />
    </div>

</div>

<div class="video-grid">

    <div class="video-column">

        <div class="video-panel">
            <span class="video-badge">A</span>
            <video class="video-player"
                   controls
                   @ref="_videoA">
            </video>
        </div>

        <table class="table table-sm mt-2">

            <tr>
                <td>Current frame</td>
                <td><strong>@CurrentFrameA</strong> (@CurrentTimeA.ToString("F3") s)</td>
            </tr>

            @MetadataRows(MetadataA)

        </table>

    </div>

    <div class="video-column">

        <div class="video-panel">
            <span class="video-badge">B</span>
            <video class="video-player"
                   controls
                   @ref="_videoB">
            </video>
        </div>

        <table class="table table-sm mt-2">

            <tr>
                <td>Current frame</td>
                <td><strong>@CurrentFrameB</strong> (@CurrentTimeB.ToString("F3") s)</td>
            </tr>

            @MetadataRows(MetadataB)

        </table>

    </div>

</div>

<div class="mt-3 d-flex gap-2 align-items-center flex-wrap">

    <button class="btn btn-primary"
            @onclick="PlayPause">
        ▶ Play / Pause
    </button>

    <button class="btn btn-secondary"
            @onclick="Stop">
        ■ Stop
    </button>

    <div class="ms-4">
        <label>FPS</label>
        <input type="number"
               class="form-control form-control-sm"
               style="width: 90px;"
               min="1"
               max="240"
               step="1"
               @bind="Fps"
               @bind:event="oninput" />
    </div>

    <div class="ms-4 d-flex align-items-center gap-2">

        <label class="mb-0">
            Offset video B:
            <strong>@FrameOffset frames</strong>
            (@OffsetSeconds.ToString("F3") s)
        </label>

        <button class="btn btn-outline-secondary btn-sm"
                @onclick="() => StepFrameOffset(-1)">
            −1 frame
        </button>

        <button class="btn btn-outline-secondary btn-sm"
                @onclick="() => StepFrameOffset(1)">
            +1 frame
        </button>

        <button class="btn btn-outline-danger btn-sm"
                @onclick="ResetOffset">
            Reset
        </button>

    </div>

</div>

<div class="mt-2">
    <input type="range"
           class="form-range"
           min="-300"
           max="300"
           step="1"
           @bind="FrameOffset"
           @bind:event="oninput"
           @bind:after="ApplyOffset" />
</div>

@code {
    private static string Display(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;
}